# =============================================================================
#  env.production.example — modèle pour le .env de PRODUCTION (NON COMMITTÉ)
# =============================================================================
#  Copier ce fichier sur le serveur en /opt/creativeaistudio/.env puis y placer
#  les vrais secrets. Droits : chmod 600. NE JAMAIS committer le vrai .env.
#
#  Générez les secrets avec : openssl rand -hex 24 (ou 32 pour JWT_SECRET)
#
#  ATTENTION caractère '$' dans un mot de passe : écrire $$ (docker compose
#  interprète $VAR). Ex : V7@qL2!mX9$$zR4_  → mot de passe réel V7@qL2!mX9$zR4_

# ── Infrastructure ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Hôte MinIO public, SANS path : le SDK MinIO rejette un endpoint porteur d'un
# path ("no path allowed in endpoint") et la signature SigV4 porte sur le chemin
# canonique — un préfixe du type /minio ne peut donc pas être réinjecté après
# signature, ce qui casserait la publication Instagram (URL signée).
MINIO_PUBLIC_URL=https://minio.labibpro.com
# Pipeline de rendu vidéo local (FFmpeg + voix) ; MoneyPrinter n'est pas requis.
VIDEO_GENERATION_PROVIDER=local
# LLM de storyboard : ollama (historique), groq, deepseek ou openai_compatible.
# Groq/DeepSeek réutilisent leurs clés GROQ_API_KEY/DEEPSEEK_API_KEY.
# Pour OpenRouter ou un endpoint compatible personnalisé, renseigner URL/clé/modèle.
VIDEO_GENERATION_LLM_PROVIDER=ollama
VIDEO_GENERATION_LLM_BASE_URL=
VIDEO_GENERATION_LLM_API_KEY=
VIDEO_GENERATION_LLM_MODEL=
VIDEO_GENERATION_LLM_ALLOW_UNAUTHENTICATED=false
VIDEO_GENERATION_LLM_TIMEOUT_SECONDS=120
VIDEO_GENERATION_OLLAMA_URL=http://ollama:11434
VIDEO_GENERATION_OLLAMA_MODEL=qwen2.5:3b
PEXELS_API_KEY=
PIXABAY_API_KEY=
# edge = Edge TTS en ligne, sans clé API; espeak = local/offline
VIDEO_GENERATION_TTS_PROVIDER=espeak
VIDEO_GENERATION_TTS_BINARY=espeak-ng
VIDEO_GENERATION_EDGE_TTS_BINARY=edge-tts
VIDEO_GENERATION_MUSIC_DIR=
# Option de compatibilité seulement : sélectionner explicitement moneyprinter
# et renseigner ces deux variables pour réactiver l'ancien service externe.
MONEYPRINTER_API_URL=
MONEYPRINTER_API_KEY=
VIDEO_GENERATION_OUTPUT_BUCKET=video-generation-results
IMAGE_PROVIDER_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_ALLOW_UNAUTHENTICATED=false
IMAGE_PROVIDER_AUTH_HEADER=Authorization
IMAGE_PROVIDER_AUTH_SCHEME=Bearer
IMAGE_PROVIDER_API_PATH=/v1/images/generations
IMAGE_PROVIDER_SUPPORTS_NEGATIVE_PROMPT=false
IMAGE_MODEL=
IMAGE_GENERATION_OUTPUT_BUCKET=image-generation-results
IMAGE_GENERATION_MAX_OUTPUT_BYTES=33554432
IMAGE_GENERATION_MAX_IMAGE_COUNT=4

# ── Publication sociale (generation-service → agent-team-service) ────────────
# false par défaut : la publication n'est tentée que si l'agent a un canal
# Facebook/Instagram connecté (credentials chiffrés dans agent-team-service).
# Instagram exige une URL MinIO signée : MINIO_PUBLIC_URL doit être joignable
# par les serveurs de Meta.
SOCIAL_PUBLISH_ENABLED=false
# generation-service relaie la publication vers agent-team-service (interne).
AGENT_TEAM_BASE_URL=http://agent-team-service:8087
# Génération des jobs vidéo/image (topics Kafka)
VIDEO_GENERATION_INPUT_TOPIC=creativeai.video-generation
VIDEO_GENERATION_RESULT_TOPIC=creativeai.video-generation.results
IMAGE_GENERATION_INPUT_TOPIC=creativeai.image-generation
IMAGE_GENERATION_RESULT_TOPIC=creativeai.image-generation.results
GENERATION_DOWNLOAD_URL_EXPIRY_MINUTES=120

# ── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=
ENCRYPTION_KEY=
# DOIT être identique au local (défaut application.yml) → Admin@2024!
# pour que l'accès admin en ligne = dadaahouawe@gmail.com / Admin@2024!
ADMIN_PASSWORD=Admin@2024!

# ── SMTP LWS (OTP) ──────────────────────────────────────────────────────────
SPRING_MAIL_USERNAME=contact@labibpro.com
SPRING_MAIL_PASSWORD=

# ── URLs publiques ──────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://ai.labibpro.com
# Cible de la redirection navigateur au retour du callback OAuth (fail-fast :
# compose refuse de démarrer sans cette variable).
APP_FRONTEND_URL=https://ai.labibpro.com

# ── Gmail OAuth2 (agent email) ──────────────────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://ai.labibpro.com/api/auth/gmail/callback
GMAIL_FRONTEND_REDIRECT=https://ai.labibpro.com/agentique/email

# ── LLM / IA ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_URL=
# OBLIGATOIRE si TELEGRAM_WEBHOOK_URL est défini. Sans lui, le webhook n'est pas
# enregistré et l'endpoint répond 503 (fail-closed) : Telegram n'a pas de JWT,
# ce header est sa seule preuve d'origine. Format accepté par Telegram :
# A-Z a-z 0-9 _ - , de 1 à 256 caractères.
TELEGRAM_WEBHOOK_SECRET=

# ── Clés API (optionnelles) ──────────────────────────────────────────────────
TMDB_API_KEY=
SERP_API_KEY=
NUMVERIFY_KEY=
BING_SEARCH_KEY=
ACOUSTID_API_KEY=
FACEBOOK_APP_SECRET=
# Secrets de vérification des webhooks Meta. VIDE = endpoint fermé (503).
# Ils ne sont pas optionnels en pratique : sans eux, Meta ne peut pas signer
# ses POST et les réceptions sont refusées. Générer avec : openssl rand -hex 32
FACEBOOK_VERIFY_TOKEN=
# Optionnels : à ne définir QUE si une seconde application Meta est créée pour
# Instagram. Absents, les secrets Facebook sont réutilisés (cas nominal, une
# seule application Meta sert aux deux objets).
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Clé VirusTotal : sans elle le scanner reste actif (magic bytes, taille,
# motifs) mais sans antivirus externe. Les uploads restent fail-closed.
VIRUSTOTAL_API_KEY=
# Hôtes acceptés pour l'URL renvoyée par le callback OnlyOffice. Par défaut
# 'onlyoffice' (service du réseau Docker). Ajouter une valeur pour un OnlyOffice
# installé ailleurs, ex. : onlyoffice,oo.interne.labibpro.com
OFFICE_CALLBACK_ALLOWED_HOSTS=onlyoffice